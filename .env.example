APP_NAME="Document Compliance Checker"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
# The site's own timezone - every stored and displayed timestamp uses it.
# Indonesia spans three: Asia/Jakarta (WIB, +7), Asia/Makassar (WITA, +8),
# Asia/Jayapura (WIT, +9). Must match the server clock, or "last analyzed"
# will not agree with the wall clock a Document Controller is looking at.
APP_TIMEZONE=Asia/Singapore

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ----------------------------------------------------------------------
# Database (PostgreSQL)
# ----------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=document_checker
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ----------------------------------------------------------------------
# Queue
# Phase 1 runs on the `database` driver so no Redis install is required.
# Switch to `redis` for production - config only, no code change.
# ----------------------------------------------------------------------
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ----------------------------------------------------------------------
# Python document analyzer (Phase 2 - not required for Phase 1)
# ----------------------------------------------------------------------
ANALYZER_BASE_URL=http://127.0.0.1:8001
ANALYZER_API_KEY=
ANALYZER_TIMEOUT=120
ANALYZER_ENABLED=false

# ----------------------------------------------------------------------
# Microsoft Graph / SharePoint
#
# Required only if you register a SharePoint source. Never commit real
# values. Certificate authentication is preferred in production: a
# certificate can be rotated on a schedule and cannot be copy-pasted out
# of a config file the way a secret can.
#
# The app registration needs the application permission
# Sites.Read.All (or Sites.Selected, scoped to the specific site), with
# admin consent granted.
#
# Once set, run `php artisan graph:discover contoso.sharepoint.com
# /sites/DocumentControl` to find the site and drive IDs.
# ----------------------------------------------------------------------
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=

# Development only.
MS_GRAPH_CLIENT_SECRET=

# Production. A PKCS#12 (.pfx) bundle or a PEM holding cert + private key.
# The path must be readable by the web server AND the queue worker account.
MS_GRAPH_CERTIFICATE_PATH=
MS_GRAPH_CERTIFICATE_PASSWORD=

# Optional. Override for sovereign clouds, or to tune throttling behaviour.
# MS_GRAPH_LOGIN_BASE_URL=https://login.microsoftonline.com
# MS_GRAPH_BASE_URL=https://graph.microsoft.com
# MS_GRAPH_PAGE_SIZE=200
# MS_GRAPH_MAX_RETRIES=4

# ----------------------------------------------------------------------
# Document control defaults
# Runtime values live in the `settings` table; these are the fallbacks
# used before an administrator overrides them.
# ----------------------------------------------------------------------
DOCCHECK_MIN_CHARS_EN=100
DOCCHECK_MIN_CHARS_ID=100
DOCCHECK_MIN_CHARS_ZH=50
DOCCHECK_MIN_COMPLIANCE_SCORE=80
DOCCHECK_MAX_UPLOAD_KB=65536
DOCCHECK_TEMP_RETENTION_HOURS=24
DOCCHECK_DEFAULT_SCAN_INTERVAL=60
DOCCHECK_OCR_ENABLED=false
DOCCHECK_AI_SEMANTIC_ENABLED=false
