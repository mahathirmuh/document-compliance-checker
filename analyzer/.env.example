# Document Trilingual Analyzer
#
# Copy to .env and adjust. Never commit real values.

# --- Service ----------------------------------------------------------------
ANALYZER_HOST=127.0.0.1
ANALYZER_PORT=8001
ANALYZER_DEBUG=false

# Shared secret the Laravel application must present as a bearer token.
# Must match ANALYZER_API_KEY in the Laravel .env.
# Leave blank only for local development on a loopback bind.
ANALYZER_API_KEY=

# --- Filesystem access ------------------------------------------------------
# Directories this service is allowed to read documents from, separated by ';'.
# STRONGLY recommended in production: without it, anyone who can reach the port
# can have the service read any file its account can open.
#
# Example:
#   ANALYZER_ALLOWED_ROOTS=D:\DocumentControl;C:\inetpub\docchecker\storage\app
ANALYZER_ALLOWED_ROOTS=

# Refuse anything larger, rather than exhausting memory. Bytes.
ANALYZER_MAX_FILE_BYTES=536870912

# --- Extraction limits ------------------------------------------------------
ANALYZER_MAX_PDF_PAGES=2000
ANALYZER_MAX_XLSX_CELLS=500000

# Below this many meaningful characters the document is reported as
# OCR_REQUIRED rather than as a translation failure.
ANALYZER_MIN_EXTRACTABLE_CHARS=20

# Latin segments shorter than this are pooled and classified together instead
# of being guessed at individually.
ANALYZER_MIN_LATIN_SEGMENT_CHARS=12
