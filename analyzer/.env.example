# Document Trilingual Analyzer
#
# Copy to .env and adjust. Never commit real values.

# --- Service ----------------------------------------------------------------
ANALYZER_HOST=127.0.0.1
ANALYZER_PORT=8001
ANALYZER_DEBUG=false

# Shared secret the Laravel application must present as a bearer token.
# Must match ANALYZER_API_KEY in the Laravel .env.
# Leave blank only for local development on a loopback bind.
ANALYZER_API_KEY=

# --- Filesystem access ------------------------------------------------------
# Directories this service is allowed to read documents from, separated by ';'.
# STRONGLY recommended in production: without it, anyone who can reach the port
# can have the service read any file its account can open.
#
# Example:
#   ANALYZER_ALLOWED_ROOTS=D:\DocumentControl;C:\inetpub\docchecker\storage\app
ANALYZER_ALLOWED_ROOTS=

# Refuse anything larger, rather than exhausting memory. Bytes.
ANALYZER_MAX_FILE_BYTES=536870912

# --- Extraction limits ------------------------------------------------------
ANALYZER_MAX_PDF_PAGES=2000
ANALYZER_MAX_XLSX_CELLS=500000

# Below this many meaningful characters the document is reported as
# OCR_REQUIRED rather than as a translation failure.
ANALYZER_MIN_EXTRACTABLE_CHARS=20

# Latin segments shorter than this are pooled and classified together instead
# of being guessed at individually.
ANALYZER_MIN_LATIN_SEGMENT_CHARS=12

# --- Section analysis -------------------------------------------------------
# Sections shorter than this are measured but never reported as missing a
# language: a heading cannot reasonably carry three translations.
ANALYZER_MIN_SECTION_CHARS=120

# A language shorter than this fraction of its section's longest language is
# reported as a suspiciously short translation.
ANALYZER_SHORT_TRANSLATION_RATIO=0.35

# How many Latin characters one Han character is worth when comparing
# translation lengths. Chinese says the same thing in about a third of the
# characters; without this every correct Chinese section reads as "too short".
ANALYZER_CHINESE_DENSITY_FACTOR=3.0

# --- OCR --------------------------------------------------------------------
# Off by default. Requires the Tesseract binary AND language data for eng,
# ind and chi_sim - the Python packages alone are not enough.
#   Windows: winget install UB-Mannheim.TesseractOCR
#   Debian:  apt install tesseract-ocr tesseract-ocr-ind tesseract-ocr-chi-sim
#
# With OCR off, or Tesseract missing, a scanned PDF is still reported as
# OCR_REQUIRED and routed to human review - never as a translation failure.
ANALYZER_OCR_ENABLED=false

# Full path to the binary. Leave blank to find it on PATH.
# ANALYZER_TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe

# Where the .traineddata language files live. Needed when they are not beside
# the binary - the normal case when Tesseract is installed machine-wide but the
# extra languages were added without administrator rights.
# ANALYZER_TESSDATA_DIR=C:\Users\itsupport\Tools\tessdata

ANALYZER_OCR_LANGUAGES=eng,ind,chi_sim

# Render scale relative to 72 dpi, so 2.8 is roughly 200 dpi.
ANALYZER_OCR_RENDER_SCALE=2.8

# OCR takes seconds per page; this stops a 300-page scan holding a worker.
ANALYZER_OCR_MAX_PAGES=50

ANALYZER_OCR_MIN_CONFIDENCE=0.60
